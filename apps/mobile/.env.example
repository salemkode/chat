# Copy to .env.local after pulling from EAS, or run:
#   eas env:pull --environment development --path .env.local

# Optional native app identity overrides for local/dev builds
EXPO_APP_NAME=
EXPO_APP_SCHEME=
EXPO_IOS_BUNDLE_IDENTIFIER=
EXPO_ANDROID_PACKAGE=

EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_CLERK_ENABLE_DEV_PASSWORD_AUTH=false
EXPO_PUBLIC_APP_URL=https://chat.salemkode.com
